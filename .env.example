# Copy this file to .env and fill in real values before running docker compose.

# --- SIP honeypot listener ---
SIP_HOST=0.0.0.0
# UDP port the honeypot listens on.
SIP_PORT=5060
# Server header value used in SIP responses, also the compose-level default for the honeypot container.
SIP_USER_AGENT=FRITZ!OS 1.0
# Path (inside the container/host) where the honeypot writes its log file.
SIP_LOG_FILE=sip_honeypot.log
# If true, also log to stdout (useful for `docker compose logs`).
SIP_LOG_STDOUT=false

# --- Metrics (MySQL) ---
# Set to true to record every SIP request to MySQL and enable the dashboard/blocking features.
METRICS_ENABLED=false
# MySQL root password, used only by the mysql container to initialize the server.
MYSQL_ROOT_PASSWORD=changeme
# MySQL hostname the honeypot/web containers connect to (service name in docker compose).
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Database name created by the mysql container and used by the honeypot/web apps.
MYSQL_DATABASE=sip_honeypot
# Application-level MySQL user (not root) used by the honeypot/web apps.
MYSQL_USER=honeypot
MYSQL_PASSWORD=changeme
# Max number of metrics events buffered in memory before new events are dropped.
METRICS_QUEUE_SIZE=10000

# --- DigitalOcean automatic firewall blocking (optional, off by default) ---
# Set to true to automatically add deny rules to a DigitalOcean cloud firewall for scanning IPs.
# Requires METRICS_ENABLED=true. Read the security warning in README.md before enabling.
DO_BLOCK_ENABLED=false
# DigitalOcean API token with firewall write access. Keep this secret; never commit a real value.
DO_API_TOKEN=
# ID of the pre-existing DigitalOcean firewall to add deny rules to.
DO_FIREWALL_ID=
# Base URL of the DigitalOcean API (override for testing only).
DO_API_BASE_URL=https://api.digitalocean.com
# Timeout in seconds for calls to the DigitalOcean API.
DO_API_TIMEOUT_SECONDS=10
# Comma-separated list of CIDR ranges that must never be auto-blocked (e.g. your own management IPs).
DO_NEVER_BLOCK=
# Minimum seconds between retrying a block attempt for the same IP.
DO_RETRY_INTERVAL_SECONDS=300
# Seconds to pause all new block attempts after a DigitalOcean API failure.
DO_FAILURE_COOLDOWN_SECONDS=60
# Local safety cap on the number of IPs this honeypot will block via the API.
DO_MAX_BLOCKED_IPS=1000

# --- Web dashboard ---
# Port the dashboard listens on inside its container / is published as.
WEB_PORT=8080
# Host interface the dashboard port is published on. Keep this loopback-only unless you add your own auth/proxy.
WEB_BIND_HOST=127.0.0.1
# Set to true to require HTTP Basic Auth to access the dashboard (additional layer, off by default).
WEB_BASIC_AUTH_ENABLED=false
# Username required for Basic Auth. Required if WEB_BASIC_AUTH_ENABLED=true.
WEB_BASIC_AUTH_USERNAME=
# Password required for Basic Auth. Required if WEB_BASIC_AUTH_ENABLED=true. Keep this secret; never commit a real value.
WEB_BASIC_AUTH_PASSWORD=
